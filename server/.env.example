PORT=3000

# Option A: path to your Firebase service account JSON (recommended for local dev)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: paste the entire JSON as a single line (useful for some hosts)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: restrict CORS to your Flutter app origins (comma-separated)
# CORS_ORIGIN=http://localhost,http://127.0.0.1

